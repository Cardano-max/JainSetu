# Database
DATABASE_URL="postgresql://user:password@localhost:5432/jainsetu?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# OTP (Twilio/MSG91)
OTP_SERVICE=mock
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=JNSETU

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend URLs
ADMIN_URL=http://localhost:5173
MOBILE_APP_SCHEME=jainsetu

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
